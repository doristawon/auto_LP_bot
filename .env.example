# Robinhood Chain read RPCs, first entry is preferred for writes.
# Production: put a managed/archive-capable endpoint first; public RPC can remain as fallback.
RPC_URLS=https://rpc.mainnet.chain.robinhood.com
WALLET_ADDRESS=0x0000000000000000000000000000000000000001
FABLES_REGISTRY=0x159A113E012593D9B3cC63ad45E30F0467e13Ef3
USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168

# Safe defaults
DRY_RUN=true
ENABLE_LIVE_WRITES=false
ENABLE_AUTO_REDEPLOY=false
# Same-pool top-up invests idle balances of the active LP's two tokens while it is in range.
# It requires the live signer and execution safety gates; enable only after reviewing a dry run.
AUTO_TOPUP_ENABLED=false
# Optional idle-pair balancing requires sequential approve + swap + deposit simulation.
AUTO_TOPUP_SWAP_ENABLED=false
# The optional swap is restricted to one reviewed pool and a separate cost cap.
AUTO_TOPUP_SWAP_POOL_ID=
AUTO_TOPUP_MAX_SWAP_PRICE_IMPACT_BPS=200
AUTO_TOPUP_MIN_IDLE_USD=25
# Also used when redepositing after same-pool OOR. On USDG pairs, reserve dust only as USDG.
AUTO_TOPUP_DUST_BPS=25
AUTO_TOPUP_MIN_INTERVAL_SEC=1800
AUTO_TOPUP_MIN_GAS_ETH=0.0002
PRIVATE_KEY=
# Persist validated dashboard RPC and active signer credentials in this local, Git-ignored .env.
PERSIST_RUNTIME_CREDENTIALS=false

# Target selection
# wallet-active: automatically follows every currently active Fables LP position held by WALLET_ADDRESS.
# allowlist: only manages TARGET_POOL_IDS.
# symbols: manages pools matching TARGET_SYMBOLS.
TARGET_MODE=wallet-active
TARGET_SYMBOLS=
TARGET_POOL_IDS=
POSITION_IDS=

# Dynamic wallet LP discovery / handoff safety
WALLET_POOL_DISCOVERY_FROM_BLOCK=44000000
MANUAL_TOPOLOGY_COOLDOWN_SEC=120

# Examples for emergency static lock:
# TARGET_MODE=allowlist
# TARGET_POOL_IDS=0x31608601d541e868706aa557558a4d4f99c57e6dd13bd3362edcf05d00a16212

# Tight range strategy
TIGHT_WIDTH_BPS=120
RANGE_PRESET=fables-tight
EDGE_BUFFER_TICKS=0

# First observed out-of-range starts a timer. At/after 15 minutes, the next
# successful on-chain pool read must still be outside before withdrawal.
RANGE_CHECK_INTERVAL_MS=300000
OOR_CONFIRM_DELAY_MIN=15
# Auto-APR reinvest mode only considers pools with this much reported TVL or more.
APR_POOL_MIN_TVL_USD=30000

# Wallet, active LP and full pool state are read on the same five-minute cycle.
# Fables APR is requested only after an OOR position passes rebalance gates.
POLL_INTERVAL_MS=300000
MARKET_REFRESH_MS=300000
MARKET_STATE_REFRESH_MS=300000
POINTS_SIMULATION_INTERVAL_MS=15000
MIN_REBALANCE_INTERVAL_SEC=300
MAX_REBALANCES_PER_HOUR=3
SWAP_SLIPPAGE_BPS=50
# At each live swap compare pinned Fables, Uniswap v4 and Uniswap v3 paths for
# USDG/MOO or USDG/ORBIO. Require price-impact/slippage limits and a material
# advantage after estimated gas. All pool contracts and PoolKeys are pinned.
EXTERNAL_SWAP_ROUTES_ENABLED=false
# Includes the pool swap fee. Keep this below the cost you accept per swap.
MAX_SWAP_PRICE_IMPACT_BPS=200
# Whole-wallet weighted limit: route/balancing quote costs and slippage buffers.
CROSS_POOL_MAX_SWAP_PRICE_IMPACT_BPS=350
# Optional pool-specific ceiling for same-pool OOR redeploy only.
OOR_REBALANCE_SWAP_POOL_ID=
OOR_REBALANCE_MAX_SWAP_PRICE_IMPACT_BPS=200
WITHDRAW_SLIPPAGE_BPS=50
DEPOSIT_SLIPPAGE_BPS=50
DEPOSIT_LIQUIDITY_RESERVE_BPS=10
# -1: adaptive tick band; 0: legacy sizing; positive: fixed tick tolerance.
DEPOSIT_TICK_TOLERANCE=-1
FABLES_WALK=1000
PERMIT2_EXPIRATION_SEC=2592000

# Atomic In-Range guard for live unattended rebalance.
# Deploy contracts/Fables7702Guard.sol, delegate this wallet via EIP-7702,
# run a canary, then explicitly mark it verified. Live mode fails closed otherwise.
EIP7702_GUARD_ADDRESS=
EIP7702_GUARD_VERIFIED=false
EIP7702_GUARD_VERIFIED_FOR=
# Atomic swap+deposit is opt-in and requires the delegated Fables7702Guard/v2.
# Omit the list to use the configured WALLET_ADDRESS; otherwise list opted-in wallet addresses.
ATOMIC_DEPOSIT_ENABLED=false
ATOMIC_DEPOSIT_WALLETS=
LEGACY_EIP7702_GUARD_ADDRESS=
# Official same-pool reposition is opt-in, wallet-scoped, and requires a v3 guard.
# Leave disabled until the v3 implementation is deployed, delegated, and verified.
OFFICIAL_REPOSITION_ENABLED=false
OFFICIAL_REPOSITION_WALLETS=
OFFICIAL_EIP7702_GUARD_ADDRESS=
# Guard deployment uses a separate canary/deployer key and never falls back to PRIVATE_KEY.
GUARD_DEPLOYER_PRIVATE_KEY=

# Log/indexing
LOG_FROM_BLOCK=44000000
FEE_LOG_FROM_BLOCK=0
LOG_CHUNK_BLOCKS=5000
MIN_LOG_CHUNK_BLOCKS=500
REORG_LOOKBACK_BLOCKS=64

# Transaction guards
CLAIM_BEFORE_WITHDRAW=true
# 再平衡或官方手動換區間後，掃描零份額舊區間並領回費用（至少每 5 分鐘；費用須高於 Gas）。
AUTO_CLAIM_RETIRED_FEES=true
ALLOW_ZERO_MIN_OUT=false
MAX_GAS_GWEI=1
TX_DEADLINE_SEC=1200
TX_CONFIRMATIONS=1

# Local dashboard / accounting
DASHBOARD_ENABLED=true
# Capital-moving actions from the dashboard remain disabled unless explicitly armed.
DASHBOARD_MANUAL_CONTROL_ENABLED=false
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787
# Required only when DASHBOARD_HOST binds outside loopback; local-only deployment does not require a dashboard token.
DASHBOARD_TOKEN=
DATA_DIR=./data
STATE_FILE=./state/bot-state.json
PORTFOLIO_SNAPSHOT_INTERVAL_MS=300000

# Points tracking
ACTUAL_POINTS_BASELINE=0
ACTUAL_POINTS_BASELINE_AT=
# Disable only in targeted chain smoke workflows that do not verify points accounting.
POINTS_GLOBAL_SWAP_SCAN_ENABLED=true
# Read-RPC calls fail within this timeout; write RPC keeps ethers' default timeout.
RPC_REQUEST_TIMEOUT_MS=30000

# Optional external deposit/withdrawal adjustment
MANUAL_NET_CASHFLOW_USD=0

# Optional Fables transaction for local reverse engineering; keep personal references out of shared config.
REFERENCE_DEPOSIT_TX=
# Optional: free Blockscout API key for historical raw trace + verified ABI.
# It is NOT needed for normal Fables monitoring/trading.
BLOCKSCOUT_API_KEY=
BLOCKSCOUT_API_BASE=https://api.blockscout.com/4663/api/v2
