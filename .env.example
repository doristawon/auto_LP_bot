# Robinhood Chain
RPC_URL=https://rpc.mainnet.chain.robinhood.com
WALLET_ADDRESS=0x6F196aF3B69c521eEd9436Abc9130699dF1c50bF
FABLES_REGISTRY=0x159A113E012593D9B3cC63ad45E30F0467e13Ef3

# Default: observe only. Never commit a private key.
DRY_RUN=true
ENABLE_LIVE_WRITES=false
PRIVATE_KEY=

# v0.1 safety gate: keep false until Fables deposit ABI and swap route are verified.
ENABLE_AUTO_REDEPLOY=false

# Target pool. Symbol matching requires all symbols listed to exist in the pair.
TARGET_SYMBOLS=CASHCAT,USDG
TARGET_POOL_IDS=
POSITION_IDS=

# Tight preset ~= +/- 1.2% around the current tick, snapped to tick spacing.
TIGHT_WIDTH_BPS=120
EDGE_BUFFER_TICKS=0
OUT_OF_RANGE_CONFIRMATIONS=2
POLL_INTERVAL_MS=15000
MIN_REBALANCE_INTERVAL_SEC=300
MAX_REBALANCES_PER_HOUR=3

# Position discovery
LOG_FROM_BLOCK=0
LOG_CHUNK_BLOCKS=1000000

# Transaction guards
CLAIM_BEFORE_WITHDRAW=true
ALLOW_ZERO_MIN_OUT=false
MAX_GAS_GWEI=1
TX_DEADLINE_SEC=1200
TX_CONFIRMATIONS=1
STATE_FILE=./state/bot-state.json
