# Robinhood Chain read RPCs, first entry is preferred for writes.
# For production use at least one managed endpoint (Alchemy/QuickNode/Chainstack)
# before the public Robinhood endpoint.
RPC_URLS=https://rpc.mainnet.chain.robinhood.com
WALLET_ADDRESS=0x6F196aF3B69c521eEd9436Abc9130699dF1c50bF
FABLES_REGISTRY=0x159A113E012593D9B3cC63ad45E30F0467e13Ef3
USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168

# Safe defaults
DRY_RUN=true
ENABLE_LIVE_WRITES=false
ENABLE_AUTO_REDEPLOY=false
PRIVATE_KEY=

# Target pool(s)
TARGET_SYMBOLS=CASHCAT,USDG
TARGET_POOL_IDS=
POSITION_IDS=

# Tight range strategy
TIGHT_WIDTH_BPS=120
EDGE_BUFFER_TICKS=0
OUT_OF_RANGE_CONFIRMATIONS=2
POLL_INTERVAL_MS=15000
MARKET_REFRESH_MS=60000
MIN_REBALANCE_INTERVAL_SEC=300
MAX_REBALANCES_PER_HOUR=3

# Log/indexing
LOG_FROM_BLOCK=44000000
FEE_LOG_FROM_BLOCK=0
# 0 = start global fee denominator tracking from first bot run; set 44000000 only for historical backfill on a managed/archive RPC.
LOG_CHUNK_BLOCKS=500000
MIN_LOG_CHUNK_BLOCKS=25000
REORG_LOOKBACK_BLOCKS=64

# Transaction guards
CLAIM_BEFORE_WITHDRAW=true
ALLOW_ZERO_MIN_OUT=false
MAX_GAS_GWEI=1
TX_DEADLINE_SEC=1200
TX_CONFIRMATIONS=1

# Local dashboard
DASHBOARD_ENABLED=true
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787
DASHBOARD_TOKEN=
DATA_DIR=./data
STATE_FILE=./state/bot-state.json

# Points tracking
# Set ACTUAL_POINTS_BASELINE from Fables leaderboard to calibrate historical points.
ACTUAL_POINTS_BASELINE=0
ACTUAL_POINTS_BASELINE_AT=

# Optional manual USD adjustments for external deposits/withdrawals after baseline.
# Normally leave at 0 and use the dashboard cashflow endpoint if needed.
MANUAL_NET_CASHFLOW_USD=0

# Reference Fables deposit tx from research. The inspect tool will read raw calldata
# from RPC and write an artifact locally; live redeploy stays blocked until verified.
REFERENCE_DEPOSIT_TX=0x4473378d0f20e03c647fe0d5b22a482b5700af7638578046d41396b5adf2dd30
